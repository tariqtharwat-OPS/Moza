  "provider": {
    "cloudflare-tier1": {
      "name": "Cloudflare (Tier 1 - 3.5M Context)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.cloudflare.com/client/v4/accounts/3f8ad0f688bd41268fbc3a1059c63b57/ai/v1",
        "apiKey": "YOUR_CLOUDFLARE_API_KEY"
      },
      "models": {
        "@cf/meta/llama-4-scout-17b-16e-instruct": { "name": "[#1] Llama 4 Scout (3.5M ctx - Free) {CF}" }
      }
    },
    "nvidia": {
      "name": "NVIDIA NIM (Tier 1 - 1M Context)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "YOUR_NVIDIA_API_KEY"
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": { "name": "[#2] Nemotron 3 Ultra 550B (1.11s - 1M ctx) {NVIDIA}" },
