{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "google",
    "opencode-go",
    "huggingface",
    "alibaba-qwen",
    "together",
    "fireworks",
    "cerebras",
    "kaggle",
    "kagglemoza",
    "kaggleqwen",
    "0kaggle",
    "poolside",
    "zai",
    "siliconflow",
    "deepseek-native"
