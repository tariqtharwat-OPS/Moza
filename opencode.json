{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "mistral": {
      "name": "Mistral",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.mistral.ai/v1",
        "apiKey": "${MISTRAL_API_KEY}"
      },
      "models": {
        "codestral-latest": { "name": "Mistral Codestral (Best for Code) ✅" },
        "mistral-small-latest": { "name": "Mistral Small (Fastest) ✅" },
        "open-mistral-nemo": { "name": "Mistral Nemo ✅" }
      }
    },
    "sambanova": {
      "name": "SambaNova",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.sambanova.ai/v1",
        "apiKey": "${SAMBANOVA_API_KEY}"
      },
      "models": {
        "DeepSeek-V3.2": { "name": "DeepSeek V3.2 (Daily Reset) ✅" }
      }
    },
    "openrouter": {
      "name": "OpenRouter Free",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "${OPENROUTER_API_KEY}"
      },
      "models": {
        "google/gemma-4-26b-a4b-it:free": { "name": "Gemma 4 26B ✅" },
        "nvidia/nemotron-3-super-120b-a12b:free": { "name": "Nemotron 3 Super 120B ✅" },
        "nvidia/nemotron-3-ultra-550b-a55b:free": { "name": "Nemotron 3 Ultra 550B ✅" },
        "openai/gpt-oss-20b:free": { "name": "GPT OSS 20B ✅" }
      }
    },
    "zai": {
      "name": "Z.ai GLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://open.bigmodel.cn/api/paas/v4",
        "apiKey": "${ZAI_API_KEY}"
      },
      "models": {
        "glm-4-flash": { "name": "GLM 4 Flash ✅" },
        "glm-5.2": { "name": "GLM 5.2 (20M Free Tokens) ✅" }
      }
    },
    "nvidia": {
      "name": "NVIDIA NIM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "${NVIDIA_API_KEY}"
      },
      "models": {
        "meta/llama-3.3-70b-instruct": { "name": "NVIDIA Llama 3.3 70B" },
        "openai/gpt-oss-120b": { "name": "NVIDIA GPT OSS 120B" },
        "mistralai/codestral-22b-instruct-v0.1": { "name": "NVIDIA Codestral 22B" },
        "ibm/granite-34b-code-instruct": { "name": "NVIDIA Granite 34B Code" },
        "nvidia/nemotron-3-super-120b-a12b": { "name": "NVIDIA Nemotron 3 Super 120B" },
        "nvidia/nemotron-3-ultra-550b-a55b": { "name": "NVIDIA Nemotron 3 Ultra 550B" },
        "deepseek-ai/deepseek-v4-pro": { "name": "NVIDIA DeepSeek V4 Pro" },
        "z-ai/glm-5.2": { "name": "NVIDIA GLM 5.2 (Redundant)" }
      }
    },
    "google-custom": {
      "name": "Google Gemini",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "apiKey": "${GOOGLE_API_KEY}"
      },
      "models": {
        "gemini-2.5-flash": { "name": "Gemini 2.5 Flash ✅" },
        "gemini-flash-latest": { "name": "Gemini Flash Latest ✅" }
      }
    },
    "cloudflare": {
      "name": "Cloudflare Workers AI",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1",
        "apiKey": "${CLOUDFLARE_API_TOKEN}"
      },
      "models": {
        "@cf/meta/llama-3.1-8b-instruct": { "name": "Cloudflare Llama 3.1 8B" },
        "@cf/meta/llama-3.1-70b-instruct": { "name": "Cloudflare Llama 3.1 70B" },
        "@cf/deepseek-ai/deepseek-r1-distill-qwen-32b": { "name": "Cloudflare DeepSeek R1 Distill" }
      }
    }
  }
}
